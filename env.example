OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
MODEL_NAME=z-ai/glm-4.5-air:free
TELEGRAM_BOT_TOKEN=
MAX_HISTORY_MESSAGES=20
TAVILY_API_KEY=

# История диалогов (SQLite). По умолчанию — ./data/chat_history.db от корня проекта.
# В Docker compose задано /app/data/chat_history.db (том ./data).
# CHAT_HISTORY_DB=

# Langfuse (опционально: Langfuse SDK 3.x требует сервер Langfuse 3.x)
# LANGFUSE_ENABLED=true
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=http://localhost:3000
